# Local data (default location is ~/Documents/data/gpx-osm-missing-paths/; these
# entries are a safety net for anyone who overrides GPX_DIR/CLUSTERS_DIR/OUTPUT_DIR back in-repo)
gpx/*
!gpx/.gitkeep
clusters/
output/
.env

# City OSM extracts (country PBF lives in ~/.cache/osm via dotfiles fetch-osm)
osm/*.osm
osm/*.osm.pbf
osm/*-r*km.poly
# Keep committed city boundaries: osm/*.poly (except radius circles)

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
