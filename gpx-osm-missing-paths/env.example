# --- OSM source (shared cache; do not download Geofabrik inside this project) ---
# Country PBF is maintained by dotfiles launchd agent com.arbatov.fetch-osm
# (dotfiles/bin/fetch-osm → ~/.cache/osm). Weekly refresh; also: make country
OSM_CACHE_DIR=~/.cache/osm
# Geofabrik URL basename, or full path override via OSM_PBF_PATH after make city
OSM_COUNTRY_FILE=vietnam-latest.osm.pbf
OSM_URL=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf

# City boundary (osmconvert .poly). Default HCMC; any city/country works:
#   BOUNDARY_POLYGON=osm/hanoi.poly  + matching OSM_COUNTRY_FILE / OSM_URL
BOUNDARY_POLYGON=osm/hcm.poly
# After `make city`, pipeline uses the clipped extract (preferred):
# OSM_PBF_PATH=osm/hcm.osm.pbf
# Leave unset to auto-resolve: osm/<city>.osm.pbf from BOUNDARY_POLYGON basename.

# Directories
GPX_DIR=./gpx
CLUSTERS_DIR=./clusters
OUTPUT_DIR=./output

# Clustering & naming
MIN_SEGMENT_LENGTH_M=25
# Long runs get cut into ~this many meters before clustering/coverage checks, so a
# missing alley mid-run doesn't get averaged away by the rest of an already-mapped route.
SEGMENT_CHUNK_LENGTH_M=750
SIMPLIFY_TOLERANCE_M=4.0
CLUSTER_BUFFER_M=50
POI_SEARCH_RADIUS_M=50
MIN_POI_DISTANCE_M=10
HDBSCAN_MIN_CLUSTER_SIZE=8
HDBSCAN_MIN_SAMPLES=3

# Missing-path filter (coverage of cluster by existing OSM ways)
EXISTING_PATH_MATCH_BUFFER_M=12
MISSING_COVERAGE_THRESHOLD=0.45
