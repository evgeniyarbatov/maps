# Path to your local OSM PBF extract (required for naming + .osm extracts)
# Get from https://download.geofabrik.de/ or use osmium to cut a city bbox
OSM_PBF_PATH=/data/osm/vietnam-latest.osm.pbf
# Or for smaller: /data/osm/hcmc.osm.pbf (recommended for speed)

# Directories
GPX_DIR=./gpx
CLUSTERS_DIR=./clusters
OUTPUT_DIR=./output

# Clustering & naming params (tune these)
MIN_SEGMENT_LENGTH_M=25
SIMPLIFY_TOLERANCE_M=4.0
CLUSTER_BUFFER_M=50          # for .osm extract and POI search
POI_SEARCH_RADIUS_M=50
MIN_POI_DISTANCE_M=10        # ignore too close duplicates
HDBSCAN_MIN_CLUSTER_SIZE=8   # tune based on your # of runs; lower = more clusters
HDBSCAN_MIN_SAMPLES=3

# Optional: OSRM local for advanced map-matching (see docs)
OSRM_URL=http://localhost:5000
USE_OSRM_MATCH=false         # experimental; requires graph built
